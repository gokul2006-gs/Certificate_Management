PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_certificate_db
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=20
STORAGE_PROVIDER=local
COOKIE_NAME=sc_session

# Optional production storage
# STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# Optional BullMQ / Redis for large generation jobs
REDIS_URL=

# Seed credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@techscube.local
