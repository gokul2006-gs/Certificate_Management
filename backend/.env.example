PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/smart_certificate_db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=20
STORAGE_PROVIDER=local
COOKIE_NAME=sc_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
UPLOAD_ROOT=./uploads
API_PUBLIC_URL=http://localhost:8080

# First administrator is created only when ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@techscube.local
ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_STUDENT_PASSWORD=Tech@123

# SMTP is optional; when configured the API sends issue and expiry notices.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
